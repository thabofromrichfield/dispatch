# Copy to .env (ignored by Git) and set these values after rotating any exposed keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-rotated-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-rotated-service-role-key
# Optional server-side TomTom key; kept on the server and never commit .env.
TOMTOM_API_KEY=
# Use true behind HTTPS; only set false for localhost development over HTTP.
DISPATCH_COOKIE_SECURE=false
# Optional: allow a trusted reverse proxy to mark requests as HTTPS.
DISPATCH_TRUST_PROXY=false
# Bind only to this computer for local VS Code use. Change only behind a trusted proxy.
HOST=127.0.0.1
PORT=3000
